# Rendu par l'image nginx (envsubst) : ${DOMAIN} provient de l'environnement.

# Limitation de débit : protège la connexion et le formulaire public contre la force brute.
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

upstream backend {
    server backend:8000;
}

server {
    listen 80;
    server_name ${DOMAIN};

    # Défi ACME (Let's Encrypt)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # En-têtes de sécurité : snippet inclus ici ET dans chaque location qui définit son propre add_header
    # (nginx n'hérite plus des add_header du serveur dès qu'une location en déclare un).
    include /etc/nginx/security_headers.conf;

    client_max_body_size 8m;   # photos et justificatifs (limite applicative : 5 Mo)
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # --- API Django ---
    location = /api/auth/login/ {
        limit_req zone=login burst=5 nodelay;
        include /etc/nginx/proxy_params.conf;
        proxy_pass http://backend;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        include /etc/nginx/proxy_params.conf;
        proxy_pass http://backend;
    }

    location /django-admin/ {
        include /etc/nginx/proxy_params.conf;
        proxy_pass http://backend;
    }

    location /static/ {
        include /etc/nginx/proxy_params.conf;
        proxy_pass http://backend;
    }

    # Fichiers privés : jamais accessibles directement, uniquement via X-Accel-Redirect
    # émis par Django après vérification de la signature de l'URL.
    location /_protected_media/ {
        internal;
        alias /data/media/;
    }

    # --- Application React (SPA) ---
    root /usr/share/nginx/html;
    index index.html;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security_headers.conf;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security_headers.conf;
        try_files $uri /index.html;
    }
}
