# === Production — copier vers .env et renseigner TOUTES les valeurs sensibles ===
# Ne jamais versionner le fichier .env.

# Nom de domaine public (HTTPS) — ex. daara.exemple.sn
DOMAIN=localhost

# Clé secrète Django : générer avec
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Base de données
POSTGRES_DB=daara
POSTGRES_USER=daara
POSTGRES_PASSWORD=

# Établissement et compte directeur créés au premier démarrage (aucune donnée fictive).
# Si DIRECTOR_PASSWORD est vide, un mot de passe aléatoire est affiché une fois dans les logs du service « backend ».
DAARA_NAME=Daara Internat Shaykh Aliou Fatima
DAARA_SLUG=daara-shaykh-aliou-fatima
DAARA_CITY=Kahone, Kaolack
DAARA_PHONE=
DAARA_EMAIL=
DIRECTOR_USERNAME=directeur
DIRECTOR_PASSWORD=
DIRECTOR_FIRST_NAME=
DIRECTOR_LAST_NAME=

# Sauvegardes
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24

# Let's Encrypt (deploy/init-letsencrypt.sh)
EMAIL=
